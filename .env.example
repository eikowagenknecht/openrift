# ──────────────────────────────────────────────────────────
# Shared (used by multiple containers or Docker Compose itself)
# ──────────────────────────────────────────────────────────

# User/group ID for containers that write to bind mounts (Postgres, API).
# Ensures files are owned by your host user. Find yours with: id -u / id -g
UID=1000
GID=1000

# App environment: "development" | "production" | "preview".
# - development: API returns detailed errors (stack traces, validation details).
# - production: canonical openrift.app deploy. Hides stack traces, enforces required vars.
# - preview: preview.openrift.app deploy. Same prod behavior as "production" plus
#   SEO noindex (robots meta, /robots.txt disallow, X-Robots-Tag header) so the
#   preview instance never gets indexed by search engines.
APP_ENV=development

# GHCR image tag. Set to "preview" for preview instance, "latest" for stable.
IMAGE_TAG=latest

# ──────────────────────────────────────────────────────────
# db (PostgreSQL)
# ──────────────────────────────────────────────────────────

# Database credentials. Only password needs to be changed.
POSTGRES_DB=openrift
POSTGRES_USER=openrift
POSTGRES_PASSWORD=password

# Host port for Postgres. Only affects localhost access, not inter-container communication.
DB_PORT=5432

# ──────────────────────────────────────────────────────────
# api (Hono)
# ──────────────────────────────────────────────────────────

# Connection string for the API to reach Postgres.
# In production, update the password and change localhost to db (the Compose service name).
# Always use port 5432 here — DB_PORT above only controls the host-side mapping.
DATABASE_URL=postgres://openrift:password@localhost:5432/openrift

# Host port for the API.
API_PORT=3001

# Which domains are allowed to call the API (comma-separated).
# Wildcards like *.example.com match any subdomain.
CORS_ORIGIN=https://openrift.app,https://preview.openrift.app

# Better Auth secret key. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Better Auth base URL. Set to your app's public URL.
BETTER_AUTH_URL=http://localhost:5173

# SMTP settings for email verification.
SMTP_HOST=smtp.fastmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
SMTP_USER=noreply@openrift.app
SMTP_PASS=
SMTP_FROM=OpenRift <noreply@openrift.app>

# Auto-admin: when this email registers, they are automatically made admin.
ADMIN_EMAIL=i.love@openrift.app

# OAuth — Google (https://console.cloud.google.com/ → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — Discord (https://discord.com/developers/applications → OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# CardTrader API token (https://www.cardtrader.com/en/account/api).
# Required for CardTrader price refresh. Leave empty to disable.
CARDTRADER_API_TOKEN=

# Cloudflare API token + zone ID for the admin cache purge button.
# Both must be set for the purge feature to appear enabled; leave empty to disable.
#
# Create the token (https://dash.cloudflare.com/profile/api-tokens):
#   1. Create Token → Create Custom Token
#   2. Permissions: Zone → Cache Purge → Purge
#   3. Zone Resources: Include → Specific zone → <your zone>
#   4. Continue to summary → Create Token → copy the value shown once
#
# Find the zone ID on the zone's Overview page in the Cloudflare dashboard,
# in the "API" section of the right-hand sidebar (below "Zone ID").
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Hostname this instance serves, used by deploy.sh for the targeted cache
# purge (HTML shells + API by prefix, keeping hashed assets warm). Purge
# prefixes are host-scoped, so prod and preview can purge independently even
# though they share one Cloudflare zone.
#   stable:  CLOUDFLARE_PURGE_HOST=openrift.app
#   preview: CLOUDFLARE_PURGE_HOST=preview.openrift.app
# Leave empty to fall back to purge_everything (when the CLOUDFLARE_* creds
# above are set) or to skip purging entirely (when they aren't).
CLOUDFLARE_PURGE_HOST=

# Price refresh crons. Set a schedule to enable, leave commented to disable.
# CardTrader also requires CARDTRADER_API_TOKEN above.
# CRON_TCGPLAYER=0 6 * * *
# CRON_CARDMARKET=15 6 * * *
# CRON_CARDTRADER=30 6 * * *

# Changelog Discord post cron. Set a schedule to enable, leave commented to disable.
# CRON_CHANGELOG=0 20 * * *

# Daily trade-match digest email cron (ADR-030). Defaults to 08:00 UTC daily;
# set to an empty string to disable. Only emails verified users who opted in.
# CRON_TRADE_DIGEST=0 8 * * *

# Discord webhook URLs for notifications. Each is independent — leave empty to
# disable that channel. Create webhooks in Server Settings → Integrations →
# Webhooks → "New Webhook" and copy the URL.
#   - NEW_PRINTINGS: posts when new printings are added (cron: every 15 min)
#   - CHANGELOG:     posts today's CHANGELOG.md entries (cron: CRON_CHANGELOG)
# Both can also be triggered on demand from the admin Site Settings page.
DISCORD_WEBHOOK_NEW_PRINTINGS=
DISCORD_WEBHOOK_CHANGELOG=

# Sentry error tracking. Two projects; the browser shares the SSR project
# (distinguished by the `service` tag inside Sentry).
#   - SENTRY_DSN_API: Hono/Bun API container        (project: openrift-api)
#   - SENTRY_DSN_SSR: SSR Node process AND browser  (project: openrift-ssr)
# The SSR DSN is also read by the API container to derive the destination for
# the /api/v1/sentry-tunnel route, which proxies browser envelopes through our
# own origin so they aren't blocked by tracker-blockers.
# Leave any of these unset to disable Sentry for that surface.
SENTRY_DSN_API=
SENTRY_DSN_SSR=

# OpenTelemetry tracing. When set, the API and SSR export request and DB
# query spans via OTLP/HTTP to the given base endpoint (Alloy on the
# monitoring stack: http://alloy:4318 from inside Docker, or
# http://localhost:4318 from the host). Alloy forwards traces to Tempo and
# also tails Docker container stdout for shipping to Loki, so trace_id from
# pino log lines becomes clickable in Grafana. Leave unset to disable
# tracing — the OTel SDK will not start and tracer instances become NoOps.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
# OTEL_SERVICE_NAME=openrift-api

# Log every API request (method, path, status, duration) via Hono's logger. Set to "true" to enable.
# LOG_REQUESTS=true

# Also log request bodies for debugging. Auth endpoints (/api/auth/*) are skipped to avoid
# logging credentials. Bodies over 10KB are truncated. Set to "true" to enable.
# LOG_REQUEST_BODIES=true

# Log response bodies for debugging. Auth endpoints are skipped, non-textual content
# (images, binaries) is skipped, and bodies over 10KB are truncated. Set to "true" to enable.
# LOG_RESPONSE_BODIES=true

# Deploy lockfile path. Override to run multiple instances on the same host.
# DEPLOY_LOCKFILE=/tmp/openrift-deploy.lock

# Card scanner served assets. The encoder and the OpenCV build are uploaded
# by hand to media/scan/ once per engine version (never committed; nginx
# serves /media/ as immutable, hence the version in the filename). The bank
# rebuild job reads the encoder from there, and the manifest endpoint hands
# both URLs to the browser. Values below are the built-in defaults; set them
# whenever the deployed engine version wants different filenames.
# SCAN_OPENCV_FILE names the glue script only, and the web loader derives the
# .wasm URL by swapping the extension, so both OpenCV files must share a
# basename (e.g. scan-opencv-v2.js plus scan-opencv-v2.wasm).
# SCAN_ENCODER_FILE=scan-encoder-v2.onnx
# SCAN_OPENCV_FILE=scan-opencv-v1.js

# ──────────────────────────────────────────────────────────
# web (TanStack Start)
# ──────────────────────────────────────────────────────────

# Host port for the web app (served via proxy in production).
WEB_PORT=8080

# Public origin for this deployment. Used for og:image, canonical links, sitemap, share URLs.
# Read at runtime (not baked at build time) so the same Docker image can deploy to prod and preview.
# Prod: https://openrift.app  —  Preview: https://preview.openrift.app
SITE_URL=http://localhost:5173

# ──────────────────────────────────────────────────────────
# discord-bot (card lookup bot)
# ──────────────────────────────────────────────────────────

# The bot container only starts when the "bot" compose profile is active.
# Enable it per instance by uncommenting this (docker compose reads it from
# this file). Local dev runs the bot natively via `bun run --cwd
# apps/discord-bot dev` instead.
# COMPOSE_PROFILES=bot

# Bot token from the Discord developer portal (application → Bot → Token).
# Use the production application's token on prod and the dev application's
# token everywhere else. The bot also needs the Message Content intent
# enabled on the Bot tab for [[card name]] scanning.
DISCORD_BOT_TOKEN=

# Shared service secret between the bot and the API for the bot's privileged
# group endpoints (/link redemption, tradelist lookups). Any long random
# string, e.g. `openssl rand -hex 32`; the same value must reach both
# containers (the API reads .env directly, compose passes it to the bot).
# Unset disables the group features.
DISCORD_BOT_API_SECRET=
