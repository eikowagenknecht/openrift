{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov",
    "test:watch": "vitest",
    "test:integration": "bun --env-file=../../.env run src/test/run-integration.ts",
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "bun --env-file=../../.env src/index.ts",
    "build": "tsgo",
    "build:tsc": "NODE_OPTIONS='--max-old-space-size=4096' tsc"
  },
  "dependencies": {
    "@hono/swagger-ui": "0.6.1",
    "@openrift/shared": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.219.0",
    "@opentelemetry/resources": "2.8.0",
    "@opentelemetry/sdk-node": "0.219.0",
    "@opentelemetry/semantic-conventions": "1.41.1",
    "@orpc/contract": "1.14.6",
    "@orpc/openapi": "1.14.6",
    "@orpc/server": "1.14.6",
    "@orpc/zod": "1.14.6",
    "@piltoverarchive/riftbound-deck-codes": "1.2.0",
    "@resvg/resvg-js": "2.6.2",
    "@sentry/bun": "10.58.0",
    "better-auth": "1.6.19",
    "croner": "10.0.1",
    "hono": "4.12.26",
    "hono-rate-limiter": "0.5.3",
    "kysely": "0.29.2",
    "kysely-postgres-js": "3.0.0",
    "nodemailer": "9.0.1",
    "postgres": "3.4.9",
    "prom-client": "15.1.3",
    "qrcode": "1.5.4",
    "satori": "0.26.0",
    "sharp": "0.35.1",
    "uuid": "14.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "2.8.0",
    "@opentelemetry/core": "2.8.0",
    "@opentelemetry/sdk-trace-base": "2.8.0",
    "@types/bun": "1.3.14",
    "@types/nodemailer": "8.0.1",
    "@types/qrcode": "1.5.5",
    "@typescript/native-preview": "7.0.0-dev.20260617.2",
    "@vitest/coverage-v8": "4.1.9",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
