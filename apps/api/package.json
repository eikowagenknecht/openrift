{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./rpc": {
      "types": "./dist/rpc-types.d.ts",
      "default": "./src/rpc-types.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov",
    "test:watch": "vitest",
    "test:integration": "bun --env-file=../../.env run src/test/run-integration.ts",
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "bun --env-file=../../.env src/index.ts",
    "build": "tsgo",
    "build:tsc": "NODE_OPTIONS='--max-old-space-size=4096' tsc"
  },
  "dependencies": {
    "@hono/swagger-ui": "0.6.1",
    "@hono/zod-openapi": "1.3.0",
    "@openrift/shared": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.217.0",
    "@opentelemetry/resources": "2.7.1",
    "@opentelemetry/sdk-node": "0.217.0",
    "@opentelemetry/semantic-conventions": "1.40.0",
    "@piltoverarchive/riftbound-deck-codes": "1.2.0",
    "@sentry/bun": "10.52.0",
    "better-auth": "1.6.9",
    "croner": "10.0.1",
    "hono": "4.12.18",
    "hono-rate-limiter": "0.5.3",
    "kysely": "0.28.17",
    "kysely-postgres-js": "3.0.0",
    "nodemailer": "8.0.7",
    "postgres": "3.4.9",
    "prom-client": "15.1.3",
    "sharp": "0.34.5",
    "uuid": "14.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "2.7.1",
    "@opentelemetry/core": "2.7.1",
    "@opentelemetry/sdk-trace-base": "2.7.1",
    "@types/bun": "1.3.13",
    "@types/nodemailer": "8.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260507.1",
    "@vitest/coverage-v8": "4.1.5",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  }
}
