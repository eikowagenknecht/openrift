{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov",
    "test:watch": "vitest",
    "test:integration": "bun --env-file=../../.env run src/test/run-integration.ts",
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "bun --env-file=../../.env src/index.ts",
    "build": "tsgo",
    "build:tsc": "NODE_OPTIONS='--max-old-space-size=4096' tsc",
    "typecheck": "tsgo --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.3",
    "@better-auth/core": "1.7.3",
    "@hono/swagger-ui": "0.6.1",
    "@openrift/shared": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@orpc/contract": "1.15.0",
    "@orpc/openapi": "1.15.0",
    "@orpc/server": "1.15.0",
    "@orpc/zod": "1.15.0",
    "@piltoverarchive/riftbound-deck-codes": "1.4.0",
    "@resvg/resvg-js": "2.6.2",
    "@sentry/bun": "10.73.0",
    "better-auth": "1.7.3",
    "croner": "10.0.1",
    "hono": "4.13.7",
    "hono-rate-limiter": "0.5.4",
    "kysely": "0.29.5",
    "kysely-postgres-js": "4.0.0",
    "nodemailer": "10.0.1",
    "onnxruntime-node": "1.29.0",
    "postgres": "3.4.9",
    "prom-client": "15.1.3",
    "satori": "0.33.4",
    "sharp": "0.35.4",
    "swagger-ui-dist": "5.32.15",
    "uuid": "14.0.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@types/bun": "1.4.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "5.0.0",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
