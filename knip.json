{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.ts"],
      "project": ["scripts/**/*.ts"]
    },
    "apps/discord-bot": {},
    "apps/extension": {
      "entry": ["src/entrypoints/*.ts", "scripts/**/*.ts"],
      "ignoreDependencies": ["@piltoverarchive/riftbound-deck-codes"]
    },
    "apps/api": {
      "entry": ["src/app.ts"],
      "ignore": ["src/test/**", "src/db/migrations/*.ts"],
      "ignoreDependencies": ["swagger-ui-dist"]
    },
    "apps/web": {
      "entry": ["src/routes/**/*.tsx", "src/components/cards/card-detail/index.tsx"],
      "ignore": ["src/components/ui/**", "public/sw.js"],
      "ignoreDependencies": ["@tanstack/router-cli", "@tanstack/router-plugin"]
    },
    "packages/shared": {},
    "packages/e2e": {
      "entry": ["src/**/*.spec.ts", "src/**/*.setup.ts"],
      "ignore": []
    }
  },
  "ignoreBinaries": ["wait"]
}
