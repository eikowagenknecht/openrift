{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "jsdoc",
    "import",
    "typescript",
    "oxc",
    "unicorn",
    "react",
    "react-perf",
    "jsx-a11y",
    "promise"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "warn",
    "style": "warn"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "es2024": true
  },
  "rules": {
    // Correctness Overwrites
    "jsdoc/check-tag-names": [
      "error",
      {
        "typed": true
      }
    ],

    // Suspicious Overwrites
    "preserve-caught-error": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-sort": "off",

    // Style Overwrites
    "max-statements": "off",
    "max-params": "off",
    "capitalized-comments": "off",
    "no-continue": "off",
    "no-magic-numbers": "off",
    "no-duplicate-imports": "off",
    "no-ternary": "off",
    "no-nested-ternary": "off",
    "no-namespace": "off",
    "id-length": "off",
    "init-declarations": "off",
    "one-var": "off", // One declaration per `const` reads better than a comma-chained group
    "prefer-destructuring": "off",
    "sort-imports": "off",
    "sort-keys": "off",
    "func-style": "off",
    "func-name-matching": "off", // Allow named function expressions assigned to differently-named properties (helpful in stack traces)
    "no-underscore-dangle": "off", // `_` prefix marks intentionally-unused vars; `__name__` is used for build-time globals (Vite)
    "new-cap": "off",
    "import/exports-last": "off",
    "import/no-named-export": "off",
    "import/group-exports": "off",
    "import/prefer-default-export": "off",
    "import/no-mutable-exports": "off",
    "unicorn/no-null": "off",
    "unicorn/filename-case": "off", // TanStack Router uses $paramName.tsx for dynamic routes
    "unicorn/text-encoding-identifier-case": ["warn", { "withDash": true }], // Prefer "utf-8" to match HTML spec

    // Pedantic Overwrites
    "max-lines-per-function": "off",
    "no-warning-comments": "off",
    "no-inline-comments": "off",
    "max-dependencies": "off",
    "max-depth": "off",
    "max-lines": "off",
    "max-classes-per-file": "off",
    "no-lonely-if": "off",
    "jsdoc/require-param-type": "off",
    "jsdoc/require-returns-type": "off",
    "jsdoc/require-param": "off",
    "jsdoc/require-returns": "off", // The comment standard deletes boilerplate tags; see docs/contributing.md "Comments"
    "typescript/restrict-plus-operands": [
      "warn",
      {
        "allowAny": false,
        "allowBoolean": false,
        "allowNullish": false,
        "allowNumberAndString": false,
        "allowRegExp": false
      }
    ],
    "unicorn/number-literal-case": "off", // Conflicts with oxfmt
    "unicorn/no-nested-ternary": "off", // Conflicts with oxfmt
    "unicorn/no-object-as-default-parameter": "off",
    "unicorn/max-nested-calls": "off", // Fires on idiomatic Zod/oRPC schema builders (z.array(z.object({ ... }))) where nesting is the DSL
    "oxc/branches-sharing-code": "off", // Intentional duplication is sometimes clearer than refactored shared tails

    // Restriction Overwrites
    "no-empty": "error",
    "no-regex-spaces": "error",
    "no-empty-function": "error",
    "jsdoc/check-access": "warn",
    "typescript/no-dynamic-delete": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-namespace": "error",
    "typescript/no-non-null-asserted-nullish-coalescing": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-require-imports": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "typescript/non-nullable-type-assertion-style": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@openrift/shared/contracts",
            "message": "Import the contract you need from '@openrift/shared/contracts/<module>'. The barrel pulls all 86 contract modules into one chunk that apps/web preloads on every route."
          }
        ],
        "patterns": [
          {
            "group": ["../*"],
            "message": "Use '@/' imports instead of relative parent imports"
          }
          // {
          //   "group": ["./*"],
          //   "message": "Use '@/' imports instead of relative parent imports"
          // },
          // {
          //   "group": ["."],
          //   "message": "Use '@/' imports instead of relative parent imports"
          // }
        ]
      }
    ],

    // React Overwrites
    "react/forbid-elements": [
      "error",
      {
        "forbid": [
          {
            "element": "button",
            "message": "Use a design-system primitive (Button, PageTopBarButton, ...) instead of a raw <button>. If none fits, add one to components/ui/ or disable this rule with a reason."
          }
        ]
      }
    ],
    "react/react-in-jsx-scope": "off", // React 17+ automatic JSX runtime
    "react/jsx-max-depth": "off", // Impractical for real component trees
    "react/jsx-props-no-spreading": "off", // Idiomatic React, essential for shadcn/ui

    // jsx-a11y Overwrites
    "jsx-a11y/prefer-tag-over-role": "off", // Inline SVG icons, listbox/combobox typeahead, div-based grids, and shadcn-scaffolded groups intentionally use ARIA roles; the suggested semantic tags don't fit
    "jsx-a11y/no-redundant-roles": "off", // `<input role="combobox">` is the canonical ARIA combobox pattern even when technically redundant

    // Type-aware rules. These run only under `--type-aware`, which `bun lint`
    // and the pre-commit hook both pass. Category membership brings them in the
    // same way it does untyped rules, so the "off" block below is the record of
    // what we looked at and declined.
    "typescript/await-thenable": "error",
    "typescript/no-array-delete": "error",
    "typescript/no-base-to-string": "error",
    "typescript/no-deprecated": "error",
    "typescript/no-duplicate-type-constituents": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-for-in-array": "error",
    "typescript/no-implied-eval": "error",
    "typescript/no-meaningless-void-operator": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-mixed-enums": "error",
    "typescript/no-unnecessary-qualifier": "error",
    "typescript/no-unsafe-enum-comparison": "error",
    "typescript/no-unsafe-unary-minus": "error",
    "typescript/prefer-includes": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/prefer-readonly": "error",
    "typescript/prefer-reduce-type-parameter": "error",
    "typescript/prefer-return-this-type": "error",
    "typescript/prefer-string-starts-ends-with": "error",
    "typescript/related-getter-setter-pairs": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    // TanStack Router signals a redirect and a 404 by throwing a sentinel, so
    // those two are thrown on purpose everywhere a route loader guards.
    "typescript/only-throw-error": [
      "error",
      {
        "allow": [
          {
            "from": "package",
            "package": "@tanstack/router-core",
            "name": ["Redirect", "NotFoundError"]
          }
        ]
      }
    ],
    // A switch with a default already decides what an unhandled member does;
    // this catches the one without, which falls through silently.
    "typescript/switch-exhaustiveness-check": [
      "error",
      { "considerDefaultExhaustiveForUnions": true }
    ],

    // Type-aware rules a category would otherwise enable, declined:
    "typescript/prefer-readonly-parameter-types": "off", // 20k findings; every parameter in the codebase
    "typescript/strict-boolean-expressions": "off", // 2.2k; the codebase relies on truthiness throughout
    "typescript/no-confusing-void-expression": "off", // 2.2k, and it contradicts the `() => void handler()` binding this repo standardized on
    "typescript/no-unsafe-member-access": "off", // the six no-unsafe rules are ~90% test files reading `await res.json()`
    "typescript/no-unsafe-type-assertion": "off", // flags every deliberate downcast, not an `any` leak
    "typescript/no-unsafe-assignment": "off",
    "typescript/no-unsafe-argument": "off",
    "typescript/no-unsafe-call": "off",
    "typescript/no-unsafe-return": "off",
    "typescript/no-unnecessary-type-assertion": "off", // disagrees with tsgo about which assertions are load-bearing; its autofix broke typecheck in ~20 places
    "typescript/no-unnecessary-template-expression": "off", // autofix drops the parentheses and silently changes what a log line prints
    "typescript/require-await": "off", // 463, style
    "typescript/strict-void-return": "off", // 457, overlaps no-misused-promises more strictly
    "typescript/return-await": "off", // 115, style
    "typescript/non-nullable-type-assertion-style": "off", // 110, cosmetic
    "typescript/consistent-return": "off", // 90, style
    "typescript/prefer-nullish-coalescing": "off", // 77, but `||` falling through on "" is deliberate in most of them
    "typescript/dot-notation": "off", // 47, cosmetic
    "typescript/no-unnecessary-boolean-literal-compare": "off", // 45, cosmetic
    "typescript/prefer-regexp-exec": "off", // 36, cosmetic
    "typescript/no-unnecessary-type-conversion": "off", // 36, cosmetic
    "typescript/no-unnecessary-type-arguments": "off", // 34, cosmetic
    "typescript/unbound-method": "off", // 29, almost all `expect(event.preventDefault)` and Kysely expression builders
    "typescript/require-array-sort-compare": "off", // 28 test sorts, several numeric ones worth fixing first
    "typescript/consistent-type-exports": "off", // 25, cosmetic
    "typescript/restrict-template-expressions": "off", // 12, all `unknown` in a template; no-base-to-string covers the object case
    "typescript/no-misused-spread": "off", // 12, ASCII string spreads and jsdom location stubs
    "typescript/no-redundant-type-constituents": "off", // 12, real smells but each fix is a design call
    "typescript/no-unnecessary-type-parameters": "off", // 6, same
    "typescript/prefer-find": "off", // 1, no autofix
    "typescript/no-useless-default-assignment": "off" // 1, no autofix
  },
  "ignorePatterns": [],
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "require-await": "off",
        "no-empty-function": "off",
        "typescript/no-non-null-assertion": "off",
        "promise/prefer-await-to-then": "off",
        "promise/prefer-await-to-callbacks": "off",
        "unicorn/no-useless-undefined": "off",
        "react/forbid-elements": "off",
        "typescript/no-misused-promises": "off" // mocks legitimately hand promise-returning functions to callbacks
      }
    },
    {
      "files": ["apps/web/src/components/ui/**"],
      "rules": {
        "react/forbid-elements": "off",
        "react/function-component-definition": "off", // shadcn scaffolds components as arrow consts; rewriting them adds permanent drift from upstream and noise when re-scaffolding
        "typescript/no-deprecated": "off" // same reason: a deprecation fix here is drift that survives until the next re-scaffold
      }
    },
    {
      // Code that ships to the browser must stay within the browserslist floor
      // in apps/web/package.json. Vite's build.target downlevels syntax only —
      // a missing built-in METHOD compiles through and throws at runtime, which
      // is how Map.groupBy took out every card-browser route on iOS < 17.4.
      // Map.groupBy itself is fine: apps/web/src/lib/polyfills.ts shims it.
      // Need one of these? Add a shim there and drop it from this list.
      // apps/api is deliberately excluded — it runs on Bun, which has them all.
      "files": ["apps/web/src/**", "packages/shared/src/**"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "Object",
            "property": "groupBy",
            "message": "Object.groupBy is Safari/iOS 17.4+ and is not shimmed. Use Map.groupBy (shimmed in lib/polyfills.ts), or add a shim there."
          },
          {
            "object": "Promise",
            "property": "withResolvers",
            "message": "Promise.withResolvers is Safari/iOS 17.4+ and is not shimmed. Add a shim to apps/web/src/lib/polyfills.ts before using it in browser code."
          },
          {
            "object": "Array",
            "property": "fromAsync",
            "message": "Array.fromAsync is Safari/iOS 18.4+ and is not shimmed. Add a shim to apps/web/src/lib/polyfills.ts before using it in browser code."
          },
          // Every date and time the app displays goes through
          // packages/shared/src/format-date.ts, which is ISO-only and builds
          // every absolute form from plain Date getters. A stray toLocale*String
          // reintroduces exactly what that module exists to prevent: a string
          // that differs between the UTC server and the visitor's browser, which
          // is a React #418 hydration mismatch on any SSR route, plus a second
          // date format for readers to decode. Numbers are untouched —
          // `count.toLocaleString()` stays fine, since only Date's own two
          // methods are named here.
          {
            "property": "toLocaleDateString",
            "message": "Use the date helpers from @openrift/shared (formatDay / formatDayLocal / formatMonth) instead of toLocaleDateString."
          },
          {
            "property": "toLocaleTimeString",
            "message": "Use formatTimeLocal or formatDayTimeLocal from @openrift/shared instead of toLocaleTimeString."
          }
        ]
      }
    },
    {
      // The shadcn calendar needs locale month names for its dropdown and a
      // locale day string for its `data-day` hook — those are names and test
      // handles, not dates the app displays. The browser-floor bans above stay.
      "files": ["apps/web/src/components/ui/calendar.tsx"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "Object",
            "property": "groupBy",
            "message": "Object.groupBy is Safari/iOS 17.4+ and is not shimmed. Use Map.groupBy (shimmed in lib/polyfills.ts), or add a shim there."
          },
          {
            "object": "Promise",
            "property": "withResolvers",
            "message": "Promise.withResolvers is Safari/iOS 17.4+ and is not shimmed. Add a shim to apps/web/src/lib/polyfills.ts before using it in browser code."
          },
          {
            "object": "Array",
            "property": "fromAsync",
            "message": "Array.fromAsync is Safari/iOS 18.4+ and is not shimmed. Add a shim to apps/web/src/lib/polyfills.ts before using it in browser code."
          }
        ]
      }
    },
    {
      "files": ["apps/discord-bot/src/test/**"],
      "rules": {
        // The bot package has no "@/" path alias; its test helpers import
        // production modules from the parent directory.
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["packages/e2e/**/*.ts"],
      "rules": {
        "import/no-nodejs-modules": "off",
        "react-hooks/rules-of-hooks": "off",
        "promise/avoid-new": "off",
        "no-promise-executor-return": "off",
        "no-empty-function": "off",
        "no-restricted-imports": "off"
      }
    }
  ]
}
