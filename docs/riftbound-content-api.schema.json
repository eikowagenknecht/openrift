{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "riftbound-content-api.schema.json",
  "title": "RiftboundContentDTO",
  "description": "Response schema for GET /riftbound/content/v1/contents",
  "type": "object",
  "required": ["game", "version", "lastUpdated", "sets"],
  "properties": {
    "game": {
      "type": "string",
      "description": "Game name"
    },
    "version": {
      "type": "string",
      "description": "Content version"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp of content last update"
    },
    "sets": {
      "type": "array",
      "description": "List of card sets",
      "items": {
        "$ref": "#/$defs/SetDTO"
      }
    }
  },
  "$defs": {
    "SetDTO": {
      "type": "object",
      "required": ["id", "name", "cards"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Set ID"
        },
        "name": {
          "type": "string",
          "description": "Set name"
        },
        "cards": {
          "type": "array",
          "description": "List of cards in this set",
          "items": {
            "$ref": "#/$defs/CardDTO"
          }
        }
      }
    },
    "CardDTO": {
      "type": "object",
      "required": [
        "id",
        "collectorNumber",
        "set",
        "name",
        "description",
        "type",
        "rarity",
        "faction",
        "stats",
        "keywords",
        "art",
        "flavorText",
        "tags"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Card ID"
        },
        "collectorNumber": {
          "type": "integer",
          "description": "Collector number"
        },
        "set": {
          "type": "string",
          "description": "Set identifier"
        },
        "name": {
          "type": "string",
          "description": "Card name"
        },
        "description": {
          "type": "string",
          "description": "Card description / rules text"
        },
        "type": {
          "type": "string",
          "description": "Card type"
        },
        "rarity": {
          "type": "string",
          "description": "Card rarity"
        },
        "faction": {
          "type": "string",
          "description": "Card faction / domain"
        },
        "stats": {
          "$ref": "#/$defs/CardStatsDTO",
          "description": "Card stats"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Card keywords"
        },
        "art": {
          "$ref": "#/$defs/CardArtDTO",
          "description": "Card art URLs and artist info"
        },
        "flavorText": {
          "type": "string",
          "description": "Flavor text"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Card tags"
        }
      }
    },
    "CardStatsDTO": {
      "type": "object",
      "required": ["energy", "might", "cost", "power"],
      "properties": {
        "energy": {
          "type": "integer",
          "description": "Energy stat"
        },
        "might": {
          "type": "integer",
          "description": "Might stat"
        },
        "cost": {
          "type": "integer",
          "description": "Cost stat"
        },
        "power": {
          "type": "integer",
          "description": "Power stat"
        }
      }
    },
    "CardArtDTO": {
      "type": "object",
      "required": ["thumbnailURL", "fullURL", "artist"],
      "properties": {
        "thumbnailURL": {
          "type": "string",
          "format": "uri",
          "description": "Thumbnail image URL"
        },
        "fullURL": {
          "type": "string",
          "format": "uri",
          "description": "Full resolution image URL"
        },
        "artist": {
          "type": "string",
          "description": "Artist name"
        }
      }
    }
  }
}
