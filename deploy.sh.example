#!/usr/bin/env bash
set -euo pipefail

# Deploy a ref to the VPS.
# Usage: ./deploy.sh [ref]
#
# Fetches the latest state, checks out the given ref, rebuilds containers,
# runs migrations, restarts services, and cleans up old Docker images.
#
# Examples:
#   ./deploy.sh          # Deploys main (default, used by preview instance)
#   ./deploy.sh v1.2.0   # Deploys a version tag (used by stable instance)

cd "$(dirname "$0")"

REF="${1:-main}"

echo "==> Fetching latest..."
git fetch origin --tags

echo "==> Checking out $REF..."
git checkout "$REF"

# For branches, reset to match remote exactly
if git symbolic-ref -q HEAD >/dev/null 2>&1; then
  git reset --hard "origin/$REF"
fi

echo "==> Building images..."
docker compose --profile tools build

echo "==> Running database migrations..."
docker compose run --rm migrate

echo "==> Restarting services..."
docker compose up -d

echo "==> Cleaning up old images..."
docker image prune -f

echo "==> Done. Current status:"
docker compose ps
