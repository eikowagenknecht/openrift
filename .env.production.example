POSTGRES_DB=openrift
POSTGRES_USER=openrift
POSTGRES_PASSWORD=<generate-a-strong-password>
DATABASE_URL=postgres://openrift:<password>@db:5432/openrift

# Comma-separated allowed CORS origins. Supports wildcard subdomains.
# Needed so Cloudflare preview deployments can call the beta API.
CORS_ORIGIN=https://openrift.app,https://beta.openrift.app,https://*.openrift-web.workers.dev
