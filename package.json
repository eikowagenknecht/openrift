{
  "name": "openrift",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "format": "oxfmt",
    "lint": "turbo run build && bun run lint:oxlint && bun run lint:oxfmt",
    "lint:oxlint": "oxlint --fix",
    "lint:oxfmt": "oxfmt ./apps ./packages",
    "lefthook": "lefthook",
    "db:migrate": "bun run --cwd packages/shared db:migrate",
    "db:rollback": "bun run --cwd packages/shared db:rollback",
    "db:seed": "bun run --cwd packages/shared db:seed",
    "dev:api": "turbo run dev --filter=api",
    "routes:generate": "bun run --cwd apps/web routes:generate",
    "test": "turbo run test",
    "knip": "knip",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "20.4.2",
    "@commitlint/config-conventional": "20.4.2",
    "@commitlint/types": "20.4.0",
    "knip": "5.85.0",
    "lefthook": "2.1.1",
    "oxfmt": "0.35.0",
    "oxlint": "1.50.0",
    "turbo": "2.8.12"
  },
  "packageManager": "bun@1.3.9",
  "trustedDependencies": [
    "@swc/core",
    "@tailwindcss/oxide",
    "esbuild",
    "lefthook",
    "msw",
    "oxfmt",
    "oxlint"
  ]
}
