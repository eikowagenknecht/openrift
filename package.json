{
  "name": "openrift",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "format": "oxfmt",
    "lint": "pnpm turbo run build && pnpm lint:oxlint && pnpm lint:oxfmt",
    "lint:oxlint": "oxlint --fix",
    "lint:oxfmt": "oxfmt ./apps ./packages",
    "lefthook": "lefthook",
    "db:migrate": "pnpm --filter @openrift/shared db:migrate",
    "db:rollback": "pnpm --filter @openrift/shared db:rollback",
    "db:seed": "pnpm --filter @openrift/shared db:seed",
    "dev:api": "turbo run dev --filter=api",
    "knip": "knip",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "20.4.2",
    "@commitlint/config-conventional": "20.4.2",
    "@commitlint/types": "20.4.0",
    "knip": "5.85.0",
    "lefthook": "2.1.1",
    "oxfmt": "0.34.0",
    "oxlint": "1.49.0",
    "tsx": "4.21.0",
    "turbo": "2.8.11"
  },
  "packageManager": "pnpm@10.30.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "@tailwindcss/oxide",
      "esbuild",
      "lefthook",
      "msw",
      "oxfmt",
      "oxlint"
    ]
  }
}
