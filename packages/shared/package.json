{
  "name": "@openrift/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./app-env": "./src/app-env.ts",
    "./schemas": "./src/schemas.ts",
    "./db-field-rules": "./src/db-field-rules.ts",
    "./contribute-schema": "./src/contribute-schema.ts",
    "./contracts": "./src/contracts/index.ts",
    "./contracts/*": "./src/contracts/*.ts",
    "./response-schemas": "./src/response-schemas.ts",
    "./utils": "./src/utils.ts",
    "./keywords": "./src/keywords.ts",
    "./card-tokens": "./src/card-tokens.ts",
    "./scan": "./src/scan/index.ts",
    "./deck-code": "./src/deck-code.ts",
    "./link-hosts": "./src/link-hosts.ts",
    "./qr": "./src/qr.ts",
    "./deck-codecs": "./src/deck-codecs/index.ts",
    "./types": "./src/types/index.ts",
    "./logger": "./src/logger.ts",
    "./test-factories": "./src/test-factories.ts",
    "./otel": "./src/otel/span.ts",
    "./otel-node": "./src/otel/tracing-node.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov",
    "test:watch": "vitest",
    "build": "tsgo",
    "typecheck": "tsgo",
    "dev": "tsgo --watch",
    "db:migrate": "bun --env-file=../../.env ../../scripts/run-migrations.ts",
    "db:rollback": "bun --env-file=../../.env ../../scripts/run-migrations.ts down",
    "make-admin": "bun --env-file=../../.env ../../scripts/make-admin.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@orpc/contract": "1.15.0",
    "@piltoverarchive/riftbound-deck-codes": "1.4.0",
    "pino": "10.3.1",
    "qrcode": "1.5.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/qrcode": "1.5.6",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
