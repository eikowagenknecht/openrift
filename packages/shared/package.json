{
  "name": "@openrift/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas.ts",
    "./db": "./src/db/index.ts",
    "./data/cards.json": "../../data/cards.json",
    "./data/prices.json": "../../data/prices.json"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc",
    "dev": "tsc --watch",
    "db:migrate": "bun src/db/migrate.ts",
    "db:rollback": "bun src/db/migrate.ts down",
    "db:seed": "bun src/db/seed.ts"
  },
  "dependencies": {
    "kysely": "0.28.11",
    "kysely-postgres-js": "3.0.0",
    "postgres": "^3.4.8",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/bun": "1.3.9",
    "typescript": "5.9.3"
  }
}
