{
  "name": "@openrift/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas.ts",
    "./db": "./src/db/index.ts",
    "./data/cards.json": "../../data/cards.json",
    "./data/prices.json": "../../data/prices.json"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc",
    "dev": "tsc --watch",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx src/db/migrate.ts",
    "db:rollback": "node --env-file-if-exists=../../.env --import tsx src/db/migrate.ts down",
    "db:seed": "node --env-file-if-exists=../../.env --import tsx src/db/seed.ts"
  },
  "dependencies": {
    "kysely": "^0.28.11",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/pg": "^8.16.0",
    "pg": "^8.18.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  }
}
