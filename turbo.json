{
  "$schema": "https://v2-10-0.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".output/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    // Sentinel task with no script in any package: `dependsOn: ["^topo"]` makes
    // it walk the whole workspace dependency graph, so any task depending on
    // `topo` inherits every upstream package's hash without serializing on that
    // package's real work. Needed because shared is consumed as raw source
    // (its exports point at ./src/*.ts), so a change confined to
    // packages/shared/src must invalidate both apps' test caches.
    "topo": {
      "dependsOn": ["^topo"]
    },
    "test": {
      "dependsOn": ["topo"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "test:coverage": {
      "inputs": ["src/**"],
      "cache": false
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "inputs": ["src/**"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "playwright.config.ts"],
      "cache": false
    },
    "test:e2e:headed": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "playwright.config.ts"],
      "cache": false
    },
    "test:e2e:ui": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "playwright.config.ts"],
      "cache": false,
      "persistent": true
    },
    "test:e2e:debug": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "playwright.config.ts"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "API_INTERNAL_URL",
        "VITE_API_PROXY_TARGET",
        "VITE_DISABLE_DEVTOOLS",
        "DEV_HTTPS"
      ]
    }
  }
}
