{
  "id": null,
  "uid": "openrift-database",
  "title": "OpenRift / Database",
  "tags": ["openrift", "db", "postgres"],
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "links": [
    {
      "type": "link",
      "title": "Home",
      "url": "/d/openrift-home",
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Connections & size",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "title": "Active connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "red", "value": 95 }
            ]
          },
          "custom": { "fillOpacity": 15, "lineWidth": 2, "spanNulls": false }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "pg_stat_activity_count{datname=\"openrift\"}",
          "legendFormat": "{{ state }}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Max connections",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "percentage",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(pg_stat_activity_count{datname=\"openrift\"})",
          "legendFormat": "Active",
          "refId": "A"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "title": "Database size",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1073741824 },
              { "color": "red", "value": 10737418240 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "pg_database_size_bytes{datname=\"openrift\"}",
          "legendFormat": "Size",
          "refId": "A"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "row",
      "title": "Throughput",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "panels": []
    },
    {
      "title": "Transactions per second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": { "fillOpacity": 10, "lineWidth": 2, "spanNulls": false }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{datname=\"openrift\"}[5m])",
          "legendFormat": "Commits/s",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback{datname=\"openrift\"}[5m])",
          "legendFormat": "Rollbacks/s",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Tuples per second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": { "fillOpacity": 10, "lineWidth": 2, "spanNulls": false }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(pg_stat_database_tup_fetched{datname=\"openrift\"}[5m])",
          "legendFormat": "Fetched/s",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_tup_inserted{datname=\"openrift\"}[5m])",
          "legendFormat": "Inserted/s",
          "refId": "B"
        },
        {
          "expr": "rate(pg_stat_database_tup_updated{datname=\"openrift\"}[5m])",
          "legendFormat": "Updated/s",
          "refId": "C"
        },
        {
          "expr": "rate(pg_stat_database_tup_deleted{datname=\"openrift\"}[5m])",
          "legendFormat": "Deleted/s",
          "refId": "D"
        }
      ]
    },
    {
      "type": "row",
      "title": "Health",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "panels": []
    },
    {
      "title": "Cache hit ratio",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.99 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "pg_stat_database_blks_hit{datname=\"openrift\"} / (pg_stat_database_blks_hit{datname=\"openrift\"} + pg_stat_database_blks_read{datname=\"openrift\"})",
          "legendFormat": "Cache hit ratio",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Deadlocks",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "custom": { "fillOpacity": 10, "lineWidth": 2, "spanNulls": false }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(pg_stat_database_deadlocks{datname=\"openrift\"}[5m])",
          "legendFormat": "Deadlocks/s",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Top queries (pg_stat_statements)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "panels": []
    },
    {
      "title": "Top 10 by total time",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 600 }
            ]
          },
          "custom": { "displayMode": "auto" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Total time (s)" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Mean time (s)" },
            "properties": [{ "id": "unit", "value": "s" }]
          }
        ]
      },
      "targets": [
        {
          "expr": "topk(10, pg_stat_statements_seconds_total)",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "user": true,
              "datname": true
            },
            "renameByName": {
              "query": "Query",
              "queryid": "ID",
              "Value": "Total time (s)"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [{ "targetField": "ID", "destinationType": "string" }]
          }
        },
        {
          "id": "sortBy",
          "options": { "fields": {}, "sort": [{ "field": "Total time (s)", "desc": true }] }
        }
      ]
    },
    {
      "title": "Top 10 by mean time",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 38 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 1 }
            ]
          },
          "custom": { "displayMode": "auto" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Mean time (s)" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "topk(10, pg_stat_statements_seconds_mean)",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "user": true,
              "datname": true
            },
            "renameByName": {
              "query": "Query",
              "queryid": "ID",
              "Value": "Mean time (s)"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [{ "targetField": "ID", "destinationType": "string" }]
          }
        },
        {
          "id": "sortBy",
          "options": { "fields": {}, "sort": [{ "field": "Mean time (s)", "desc": true }] }
        }
      ]
    },
    {
      "title": "Top 10 most-called",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "displayMode": "auto" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Calls/s" },
            "properties": [
              { "id": "unit", "value": "ops" },
              { "id": "custom.displayMode", "value": "color-background" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 10 },
                    { "color": "red", "value": 100 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "topk(10, rate(pg_stat_statements_calls_total[5m]))",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "user": true,
              "datname": true
            },
            "renameByName": {
              "query": "Query",
              "queryid": "ID",
              "Value": "Calls/s"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [{ "targetField": "ID", "destinationType": "string" }]
          }
        },
        {
          "id": "sortBy",
          "options": { "fields": {}, "sort": [{ "field": "Calls/s", "desc": true }] }
        }
      ]
    },
    {
      "type": "row",
      "title": "Aggregate query stats",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 58 },
      "panels": []
    },
    {
      "title": "Total DB time per second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 59 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "fillOpacity": 15, "lineWidth": 2, "spanNulls": false }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_statements_seconds_total[5m]))",
          "legendFormat": "Total query time/s",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Query calls per second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 59 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": { "fillOpacity": 15, "lineWidth": 2, "spanNulls": false }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_statements_calls_total[5m]))",
          "legendFormat": "Calls/s",
          "refId": "A"
        }
      ]
    }
  ]
}
