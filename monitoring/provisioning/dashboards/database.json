{
  "id": null,
  "uid": "openrift-database",
  "title": "OpenRift / Database",
  "tags": ["openrift", "db", "postgres"],
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "datname",
        "label": "Database",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": {
          "query": "label_values(pg_database_size_bytes, datname)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "regex": "",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": { "selected": false, "text": "openrift", "value": "openrift" }
      },
      {
        "name": "slow_threshold",
        "label": "Slow ≥",
        "type": "custom",
        "query": "5ms,10ms,25ms,50ms,100ms,250ms,500ms",
        "options": [
          { "text": "5ms", "value": "5ms", "selected": false },
          { "text": "10ms", "value": "10ms", "selected": false },
          { "text": "25ms", "value": "25ms", "selected": true },
          { "text": "50ms", "value": "50ms", "selected": false },
          { "text": "100ms", "value": "100ms", "selected": false },
          { "text": "250ms", "value": "250ms", "selected": false },
          { "text": "500ms", "value": "500ms", "selected": false }
        ],
        "current": { "selected": true, "text": "25ms", "value": "25ms" }
      }
    ]
  },
  "annotations": { "list": [] },
  "links": [
    {
      "type": "link",
      "title": "Home",
      "url": "/d/openrift-home",
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "title": "Database size",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1073741824 },
              { "color": "red", "value": 10737418240 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "pg_database_size_bytes{datname=\"$datname\"}",
          "legendFormat": "Size",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "title": "Connection pool",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(pg_stat_activity_count{datname=\"$datname\"}) / scalar(pg_settings_max_connections)",
          "legendFormat": "In use",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "title": "Transactions/s",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_xact_commit{datname=\"$datname\"}[$__rate_interval]))",
          "legendFormat": "Commits/s",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "title": "Rollbacks/s",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_xact_rollback{datname=\"$datname\"}[$__rate_interval]))",
          "legendFormat": "Rollbacks/s",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "title": "Cache hit ratio",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.99 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_blks_hit{datname=\"$datname\"}[$__range])) / (sum(rate(pg_stat_database_blks_hit{datname=\"$datname\"}[$__range])) + sum(rate(pg_stat_database_blks_read{datname=\"$datname\"}[$__range])))",
          "legendFormat": "Cache hit ratio",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "title": "Deadlocks",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(pg_stat_database_deadlocks{datname=\"$datname\"}[$__range]))",
          "legendFormat": "Deadlocks",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "row",
      "title": "Connections",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "panels": []
    },
    {
      "title": "Active connections by state",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "fillOpacity": 30,
            "lineWidth": 1,
            "spanNulls": false,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "pg_stat_activity_count{datname=\"$datname\"} > 0",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }
      }
    },
    {
      "type": "row",
      "title": "Throughput",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "panels": []
    },
    {
      "title": "Transactions per second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": { "fillOpacity": 10, "lineWidth": 2, "spanNulls": false }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{datname=\"$datname\"}[$__rate_interval])",
          "legendFormat": "Commits/s",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback{datname=\"$datname\"}[$__rate_interval])",
          "legendFormat": "Rollbacks/s",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Tuples per second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": { "fillOpacity": 10, "lineWidth": 2, "spanNulls": false }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(pg_stat_database_tup_fetched{datname=\"$datname\"}[$__rate_interval])",
          "legendFormat": "Fetched/s",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_tup_inserted{datname=\"$datname\"}[$__rate_interval])",
          "legendFormat": "Inserted/s",
          "refId": "B"
        },
        {
          "expr": "rate(pg_stat_database_tup_updated{datname=\"$datname\"}[$__rate_interval])",
          "legendFormat": "Updated/s",
          "refId": "C"
        },
        {
          "expr": "rate(pg_stat_database_tup_deleted{datname=\"$datname\"}[$__rate_interval])",
          "legendFormat": "Deleted/s",
          "refId": "D"
        }
      ]
    },
    {
      "type": "row",
      "title": "Slow DB activity",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "panels": []
    },
    {
      "title": "Slow DB spans (≥ $slow_threshold)",
      "type": "table",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "description": "DB spans at or above the threshold in the dashboard time range, sourced directly from Tempo. Click a trace ID to open the full trace and walk SSR → API → Kysely → DB.",
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "left", "displayMode": "auto" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Duration" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "custom.width", "value": 100 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Trace Name" },
            "properties": [{ "id": "custom.width", "value": 260 }]
          },
          {
            "matcher": { "id": "byName", "options": "db.query.text" },
            "properties": [
              { "id": "custom.width", "value": 700 },
              { "id": "displayName", "value": "SQL" }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "tableType": "spans",
          "limit": 50,
          "spss": 5,
          "query": "{resource.service.name=\"openrift-api\" && span.db.system.name=\"postgresql\" && duration >= $slow_threshold} | select(span.db.query.text)",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Trace Service": true,
              "db.system.name": true,
              "service.name": true
            },
            "renameByName": {},
            "indexByName": {}
          }
        }
      ]
    },
    {
      "title": "Top 10 slowest statements (mean exec time, 5m window)",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Mean execution time per normalized statement over a 5-minute window, top 10 by latency. Sourced from pg_stat_statements via postgres-exporter. pg_stat_statements only exposes mean (not percentiles); for p95 use the 'Slow DB spans' table above, which queries Tempo directly.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 5, "spanNulls": false }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "topk(10, rate(pg_stat_statements_seconds_total[5m]) / rate(pg_stat_statements_calls_total[5m]) > 0)",
          "legendFormat": "{{query}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      }
    },
    {
      "type": "row",
      "title": "DB activity by operation (OTel spans)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 46 },
      "panels": []
    },
    {
      "title": "DB query rate by operation",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 47 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{service=\"openrift-api\", db_system_name=\"postgresql\"}[$__rate_interval]))",
          "legendFormat": "{{span_name}}",
          "exemplar": true,
          "range": true,
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      }
    },
    {
      "title": "p95 DB duration by operation",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 47 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "fillOpacity": 5, "lineWidth": 2 }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, span_name) (rate(traces_spanmetrics_latency_bucket{service=\"openrift-api\", db_system_name=\"postgresql\"}[$__rate_interval])))",
          "legendFormat": "{{span_name}}",
          "exemplar": true,
          "range": true,
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      }
    }
  ]
}
