{
  "id": null,
  "uid": "openrift-home",
  "title": "OpenRift / Home",
  "tags": ["openrift", "home"],
  "schemaVersion": 39,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "links": [
    {
      "type": "link",
      "title": "API Requests",
      "url": "/d/openrift-api-requests",
      "targetBlank": false,
      "icon": "external link"
    },
    {
      "type": "link",
      "title": "OTel Traces",
      "url": "/d/openrift-otel-traces",
      "targetBlank": false,
      "icon": "external link"
    },
    {
      "type": "link",
      "title": "Postgres",
      "url": "/d/openrift-postgres",
      "targetBlank": false,
