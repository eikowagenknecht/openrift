{
  "id": null,
  "uid": "openrift-api",
  "title": "OpenRift / API Metrics",
  "tags": ["openrift", "api"],
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "annotations": { "list": [] },
  "links": [
    {
      "type": "link",
      "title": "Home",
      "url": "/d/openrift-home",
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "audience",
        "label": "Audience",
        "type": "custom",
        "query": "End-user : route!~\"/api/v[0-9]+/admin/.*|/api/admin/.*\",Admin : route=~\"/api/v[0-9]+/admin/.*|/api/admin/.*\",All : route=~\".+\"",
        "current": {
          "text": "End-user",
          "value": "route!~\"/api/v[0-9]+/admin/.*|/api/admin/.*\"",
          "selected": true
        },
        "options": [
          {
            "text": "End-user",
            "value": "route!~\"/api/v[0-9]+/admin/.*|/api/admin/.*\"",
            "selected": true
          },
          {
            "text": "Admin",
            "value": "route=~\"/api/v[0-9]+/admin/.*|/api/admin/.*\"",
            "selected": false
          },
          {
            "text": "All",
            "value": "route=~\".+\"",
            "selected": false
          }
        ],
        "hide": 0,
        "skipUrlSync": false,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "title": "RPS",
      "type": "stat",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"openrift-api\",${audience}}[$__range]))",
          "legendFormat": "RPS",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "title": "Error rate",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(sum(rate(http_requests_total{job=\"openrift-api\",status=~\"5..\",${audience}}[$__range])) or vector(0)) / clamp_min(sum(rate(http_requests_total{job=\"openrift-api\",${audience}}[$__range])), 1e-9)",
          "legendFormat": "Error %",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "type": "row",
      "title": "Latency",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "panels": []
    },
    {
      "title": "p50 / p95 / p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "fillOpacity": 5, "lineWidth": 2, "spanNulls": false }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"openrift-api\",${audience}}[5m])))",
          "legendFormat": "p50",
          "exemplar": true,
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"openrift-api\",${audience}}[5m])))",
          "legendFormat": "p95",
          "exemplar": true,
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"openrift-api\",${audience}}[5m])))",
          "legendFormat": "p99",
          "exemplar": true,
          "refId": "C"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["mean", "max"],
          "width": 420
        }
      }
    },
    {
      "type": "row",
      "title": "Status codes",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "panels": []
    },
    {
      "title": "Status code breakdown",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "spanNulls": false,
            "stacking": { "mode": "none", "group": "A" }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total{job=\"openrift-api\",${audience}}[5m])) > 0",
          "legendFormat": "{{ status }}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["mean", "max"],
          "width": 420
        }
      }
    },
    {
      "type": "row",
      "title": "Per-route RPS",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "panels": []
    },
    {
      "title": "RPS by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "spanNulls": false,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (route) (rate(http_requests_total{job=\"openrift-api\",${audience}}[5m])) > 0",
          "legendFormat": "{{ route }}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["mean", "max"],
          "width": 420
        }
      }
    },
    {
      "type": "row",
      "title": "Per-route p95 latency",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "panels": []
    },
    {
      "title": "p95 by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "fillOpacity": 10, "lineWidth": 2, "spanNulls": false }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket{job=\"openrift-api\",${audience}}[5m]))) > 0",
          "legendFormat": "{{ route }}",
          "exemplar": true,
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["mean", "max"],
          "width": 420
        }
      }
    },
    {
      "type": "row",
      "title": "Slowest routes (p95)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 },
      "panels": []
    },
    {
      "title": "Top 10 slowest",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p95 (s)" },
            "properties": [
              { "id": "unit", "value": "s" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 0.5 },
                    { "color": "red", "value": 1.0 }
                  ]
                }
              },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket{job=\"openrift-api\",${audience}}[$__range]))))",
          "legendFormat": "{{ route }}",
          "refId": "A",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "round(sum by (route) (increase(http_requests_total{job=\"openrift-api\",${audience}}[$__range]))) > 0",
          "legendFormat": "{{ route }}",
          "refId": "B",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "route", "mode": "inner" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "__name__": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "instance": true,
              "instance 1": true,
              "instance 2": true,
              "job": true,
              "job 1": true,
              "job 2": true
            },
            "renameByName": { "route": "Route", "Value #A": "p95 (s)", "Value #B": "Calls" },
            "indexByName": { "Route": 0, "p95 (s)": 1, "Calls": 2 }
          }
        },
        {
          "id": "sortBy",
          "options": { "fields": {}, "sort": [{ "field": "p95 (s)", "desc": true }] }
        }
      ]
    },
    {
      "type": "row",
      "title": "Recent traces",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 50 },
      "panels": []
    },
    {
      "title": "Recent traces",
      "type": "table",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 51 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{ resource.service.name=\"openrift-api\" && kind=server } with (most_recent=true)",
          "limit": 50,
          "tableType": "traces",
          "refId": "A"
        }
      ],
      "options": { "sortBy": [{ "displayName": "Start time", "desc": true }] },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "service": true,
              "Service": true,
              "serviceName": true,
              "Service Name": true
            },
            "renameByName": {},
            "indexByName": {}
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [{ "field": "startTime", "desc": true }]
          }
        }
      ]
    },
    {
      "title": "Recent errored traces",
      "type": "table",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 51 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{ resource.service.name=\"openrift-api\" && status=error } with (most_recent=true)",
          "limit": 50,
          "tableType": "traces",
          "refId": "A"
        }
      ],
      "options": { "sortBy": [{ "displayName": "Start time", "desc": true }] },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "service": true,
              "Service": true,
              "serviceName": true,
              "Service Name": true
            },
            "renameByName": {},
            "indexByName": {}
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [{ "field": "startTime", "desc": true }]
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Bun runtime",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 61 },
      "panels": []
    },
    {
      "title": "Event loop lag (p99)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 62 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.2 }
            ]
          },
          "custom": { "fillOpacity": 10, "lineWidth": 2, "spanNulls": false }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "nodejs_eventloop_lag_p99_seconds{job=\"openrift-api\"}",
          "legendFormat": "lag p99",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Heap used",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 62 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "fillOpacity": 10, "lineWidth": 2, "spanNulls": false }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "nodejs_heap_size_used_bytes{job=\"openrift-api\"}",
          "legendFormat": "heap used",
          "refId": "A"
        },
        {
          "expr": "nodejs_heap_size_total_bytes{job=\"openrift-api\"}",
          "legendFormat": "heap total",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Resident memory (RSS)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 62 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 536870912 },
              { "color": "red", "value": 1073741824 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"openrift-api\"}",
          "legendFormat": "RSS",
          "refId": "A"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    }
  ]
}
