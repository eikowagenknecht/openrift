{
  "id": null,
  "uid": "openrift-pipeline",
  "title": "OpenRift / Telemetry pipeline",
  "tags": ["openrift", "monitoring", "pipeline"],
  "schemaVersion": 39,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "annotations": { "list": [] },
  "links": [
    {
      "type": "link",
      "title": "Home",
      "url": "/d/openrift-home",
      "targetBlank": false,
      "icon": "external link"
    },
    {
      "type": "link",
      "title": "Logs",
      "url": "/d/openrift-logs",
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Alloy",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "up{job=\"alloy\"}", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "down", "color": "red" },
                "1": { "text": "up", "color": "green" }
              }
            }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "text": { "titleSize": 14, "valueSize": 28 },
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Spans/sec (5m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(otelcol_receiver_accepted_spans_total[5m]))", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "text": { "titleSize": 14, "valueSize": 28 },
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Logs/sec (5m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(loki_distributor_lines_received_total[5m]))", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "text": { "titleSize": 14, "valueSize": 28 },
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Drops (5m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(loki_write_dropped_entries_total[5m])) or on() vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "text": { "titleSize": 14, "valueSize": 28 },
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Total disk",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(telemetry_disk_usage_bytes{job=\"node-exporter\"})", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10737418240 },
              { "color": "red", "value": 53687091200 }
            ]
          }
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "text": { "titleSize": 14, "valueSize": 28 },
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "OTLP receive rate (Alloy)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (transport) (rate(otelcol_receiver_accepted_spans_total[$__rate_interval]))",
          "legendFormat": "{{transport}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 20 },
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 4 }
    },
    {
      "type": "timeseries",
      "title": "Loki write rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (tenant) (rate(loki_distributor_lines_received_total[$__rate_interval]))",
          "legendFormat": "{{tenant}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 20 },
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 4 }
    },
    {
      "type": "timeseries",
      "title": "Pipeline errors (should hover at 0)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(otelcol_exporter_send_failed_spans_total[$__rate_interval]))",
          "legendFormat": "alloy → tempo: span export failures",
          "refId": "A"
        },
        {
          "expr": "sum(rate(loki_write_dropped_entries_total[$__rate_interval]))",
          "legendFormat": "alloy → loki: dropped entries",
          "refId": "B"
        },
        {
          "expr": "sum(rate(loki_ingester_wal_discarded_samples_total[$__rate_interval]))",
          "legendFormat": "loki: WAL-discarded samples",
          "refId": "C"
        },
        {
          "expr": "sum(rate(otelcol_receiver_refused_spans_total[$__rate_interval]))",
          "legendFormat": "alloy: refused OTLP spans",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 30, "spanNulls": true },
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 11 }
    },
    {
      "type": "timeseries",
      "title": "Disk usage by component (stacked)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "telemetry_disk_usage_bytes{job=\"node-exporter\"}",
          "legendFormat": "{{component}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 50,
            "stacking": { "mode": "normal" }
          },
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 18 }
    },
    {
      "type": "bargauge",
      "title": "Disk usage (current)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "telemetry_disk_usage_bytes{job=\"node-exporter\"}",
          "legendFormat": "{{component}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5368709120 },
              { "color": "red", "value": 21474836480 }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color"
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 18 }
    },
    {
      "type": "table",
      "title": "Growth rate (last 7d)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "deriv(telemetry_disk_usage_bytes{job=\"node-exporter\"}[7d]) * 86400",
          "legendFormat": "{{component}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "instance": true, "job": true, "__name__": true },
            "renameByName": {
              "component": "Component",
              "Value": "Bytes / day"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [{ "field": "Bytes / day", "desc": true }]
          }
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Bytes / day" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "mode": "gradient" }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 104857600 },
                    { "color": "red", "value": 1073741824 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": { "showHeader": true },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 26 }
    }
  ]
}
